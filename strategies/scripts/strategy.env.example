# =============================================================================
# OpenAlgo Strategy Tunables — reference template
# =============================================================================
# Tunable parameters for the two paper-trading strategies (EMA crossover +
# short straddle). They are read via os.getenv() in the strategy scripts with
# the defaults shown below.
#
# HOW TO OVERRIDE: copy the line(s) you want to change into the OpenAlgo .env.
# OpenAlgo loads .env into the environment (load_dotenv), and each strategy
# subprocess inherits it (os.environ.copy()), so a value set in .env overrides
# the code default. Change takes effect on the next strategy start/restart.
# Many active values are echoed in the strategy's [INIT] log lines — check
# those to confirm an override took effect.
#
# This file is a REFERENCE ONLY (committed). It is NOT auto-loaded, and it
# contains NO secrets. Defaults below reflect the live config as of 2026-06-15.
# See ADAPTIVE_PROFIT_EXIT_DESIGN.md for the APPE / crossover-gate rationale.
# =============================================================================


# ---- Shared (both strategies) -----------------------------------------------
OPENALGO_HOST=http://127.0.0.1:5000        # local OpenAlgo REST endpoint
# OPENALGO_API_KEY=<your-api-key>          # SECRET — set in .env only, never commit
STATE_DIR=/root/data/openalgo/strategies/state   # per-strategy state JSON dir
FEED_STALE_SEC=60                          # market-data feed treated as stale after N sec w/o ticks
# WEBSOCKET_URL=ws://127.0.0.1:8765        # feed endpoint; default is ws://WEBSOCKET_HOST:WEBSOCKET_PORT
# WEBSOCKET_HOST=127.0.0.1
# WEBSOCKET_PORT=8765
# STRATEGY_NAME is set by the Strategy host from the strategy's config name (not via .env)


# =============================================================================
# EMA CROSSOVER  (BANKNIFTY, EMA 9/21, 5m)
# =============================================================================
# -- instrument / execution --
SYMBOL=BANKNIFTY                 # underlying; resolves to the current future (e.g. BANKNIFTY30JUN26FUT)
EXCHANGE=NFO
PRODUCT=MIS                      # intraday
QUANTITY=60                      # total qty traded
LOT_SIZE=30                      # 1 lot; units = QUANTITY/LOT_SIZE (=2) — drives APPE arm & give-back scaling
CANDLE_TIMEFRAME=5m
TRADE_DIRECTION=BOTH             # LONG | SHORT | BOTH
SIGNAL_CHECK_INTERVAL=10         # seconds between signal polls
LOOKBACK_DAYS=3                  # history days fetched (EMA warmup)

# -- signal / crossover-quality gate (design doc §14/§16) --
FAST_EMA=9
SLOW_EMA=21
VOLUME_FILTER_MULT=1.5           # require candle volume > MULT × SMA(VOLUME_SMA_PERIOD)
VOLUME_SMA_PERIOD=20
REVERSE_CONFIRM_PCT=0.0003       # min |EMA9-EMA21| gap AT the cross, as % of price (0.03% ≈ 17 pts); gates ENTRY & REVERSE

# -- risk / exits --
TRAILING_SL_PCT=0.5              # trailing stop, % from peak (tick-driven)
MAX_LOSS_PER_DAY=5000            # daily circuit breaker (₹) — halts new trades for the day once cumulative ≤ -this

# -- APPE adaptive profit-protection exit (design doc §4/§5) --
APPE_ENABLED=true
ARM_PER_LOT=4000                 # APPE arms at ARM_PER_LOT × units (₹4000×2 = ₹8000 @ 60qty) — "HAVRATPANA CONTROL"
# PROFIT_ARM_THRESHOLD=          # (optional) absolute ₹ arm; if set, OVERRIDES the ARM_PER_LOT×units formula
GIVEBACK_K=30                    # give-back budget  G = K·√P_max · √(units/GIVEBACK_REF_UNITS)
GIVEBACK_REF_UNITS=2             # units anchor for the √-scaling (factor 1 → no-op at 60 qty)
TREND_WINDOW_SEC=180             # APPE slope lookback (Gate 3a)
TREND_CONFIRM_SEC=30             # APPE breach confirm / patience (Gate 3b)
HARD_MULT=2.0                    # APPE catastrophic give-back multiple → immediate exit (Gate 4)


# =============================================================================
# SHORT STRADDLE / IRON BUTTERFLY  (NIFTY ATM)
# =============================================================================
# -- instrument / execution --
UNDERLYING=NIFTY
EXCHANGE=NFO
INDEX_EXCHANGE=NSE_INDEX
PRODUCT=MIS
LOTS=3                           # QUANTITY = LOTS × LOT_SIZE (=195)
LOT_SIZE=65
PNL_CHECK_INTERVAL=5             # seconds between REST P&L polls (straddle is REST-driven, not WS)

# -- timing (IST) --
ENTRY_HOUR=9
ENTRY_MINUTE=35                  # entry window is 09:35–09:39 (hard 5-min window)
SQUAREOFF_HOUR=15
SQUAREOFF_MINUTE=14              # EOD square-off 15:14 (before the 15:15 analyzer cutoff)

# -- targets (% of net premium collected) --
PROFIT_TARGET_PCT=25
STOPLOSS_PCT=50

# -- hedge (iron butterfly) --
ENABLE_HEDGE=true                # buy OTM wings → capped max loss (false = naked straddle)
HEDGE_OFFSET=OTM8                # wing distance from ATM

# -- entry skip filters (the strategy logs a startup NO-TRADE banner if any deterministic one fires) --
SKIP_EXPIRY_DAY=true             # no straddle on expiry day (gamma risk)
SKIP_EVENT_DAYS=true             # skip high-vol event days (CPI/FOMC/RBI…) listed in EVENT_CALENDAR_FILE
SKIP_GAP_OPEN=true               # skip if index gaps > GAP_THRESHOLD_PCT from prev close
GAP_THRESHOLD_PCT=1.0
SKIP_TREND_DAY=true              # skip if opening-range breakout signals a trend day
ORB_MINUTES=15                   # opening-range window for the trend-day check
ORB_BREAKOUT_PCT=0.5
SKIP_VIX_CHECK=false             # if false, enforce VIX_THRESHOLD below
VIX_THRESHOLD=25.0               # skip entry if India VIX > this
CONSECUTIVE_SL_LIMIT=2           # cooldown: skip entry after N consecutive SL days
# EVENT_CALENDAR_FILE=           # (optional) path to the high-vol event-day calendar file
