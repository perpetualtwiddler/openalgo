# Ignore all strategy scripts uploaded by users
*.py

# But keep this .gitignore file
!.gitignore

# Keep our strategy and tooling scripts
!short_straddle_nifty.py
!ema_crossover_banknifty.py
!ema_regime_banknifty.py
!regime_scan.py
!fast_scan.py
!capture_trade_data.py
!backtest_offline.py
!backtest_ticks.py
!backtest_straddle_today.py
!backtest_straddle_history.py
!build_generic_csv.py
!charges.py
!analyze_hedge_cost.py
!sim_ema_today.py
!test_straddle_filters.py
!ema_crossover_banknifty_3m_20260617.py
!ema_crossover_banknifty_opt4_20260618.py
!backtest_ema_dev.py

# EOD / analysis tooling. These were previously force-added one at a time, which left this
# allowlist lying about what is tracked -- `git status` showed nothing for a modified tool and
# a new one needed `add -f` to be noticed at all. Listed properly so the ignore file matches
# reality. NOTE: only CODE is tracked. Live trading artefacts stay out of git -- log/*.csv is
# ignored repo-wide and log/trade_analytics.xlsx embeds per-day fills and P&L, and the
# mkds-openalgo remote is a PUBLIC fork of marketcalls/openalgo.
!archive_tradebook.py
!eod_summary.py
!exit_timing_eval.py
!growth_model_xlsx.py
!trade_journal.py
!validate_journal.py
!status_check.py
!trade_analytics_xlsx.py

# Keep docs
!STRATEGIES.md

# Ignore log files if any
*.log

# Ignore backup files
*.bak
*.backup
*~

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Keep the directory but ignore contents
# This ensures the scripts folder exists in git but user strategies are not tracked